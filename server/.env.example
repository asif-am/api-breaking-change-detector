# Server configuration (copy to server/.env and adjust)
PORT=5000
NODE_ENV=development

# MongoDB connection string. Accounts, sessions, projects and history need it.
MONGODB_URI=mongodb://127.0.0.1:27017/api_breaking_change_detector

# Secret used to sign the session cookie. Replace with a long random string
# before deploying anything beyond local development.
SESSION_SECRET=replace-this-with-a-long-random-secret

# Password given to the demo account created by "npm run seed".
DEMO_PASSWORD=replace-with-a-demo-password

# Origin of the Vite dev server (used for CORS with credentials).
CLIENT_URL=http://localhost:5173
